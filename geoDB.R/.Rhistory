for (i in 1:999){
}
R1.means <- R1$means
R1.sds <- R1$sds
R2.se <- numeric(999)
for (i in 1:999){
R2 <- simulate.999(mean = R1.means[i], sd = R1.sds[i], n = sample.size)
R2.se[i] <- sd(R2$percentiles)
}
R1.percentiles <- R1$percentiles
CI.min <- numeric(999)
CI.max <- numeric(999)
for (i in 1:999){
CI.min[i] <- R1.percentiles[i]-1.96*R2.se[i]
CI.max[i] <- R1.percentiles[i]+1.96*R2.se[i]
}
count <- 0
for (i in 1:999){
if(true.99.9 <= CI.max[i] && true.99.9 >= CI.min[i]){
count <- count + 1
}
}
print(paste0("Count of confidence intervals that contain the true percentile: ", count))
print(paste0("This is equal to a correct percentage of: ", 100*count/999,"%"))
simulate.999 <- function(mean, sd, n){
percentiles.99.9 <- numeric(999)
means <- numeric(999)
sds <- numeric(999)
for (i in 1:999) {
sim <- rnorm(n , mean = mean, sd = sd)
means[i] <- mean(sim)
sds[i] <- sd(sim)
percentiles.99.9[i] <- qnorm(0.999, mean = means[i], sd = sds[i])
}
return ( list(means = means, sds = sds, percentiles = percentiles.99.9) )
}
R1 <- simulate.999(mean = true.mean, sd = true.sd, n = sample.size)
R1.means <- R1$means
R1.sds <- R1$sds
R2.se <- numeric(999)
for (i in 1:999){
R2 <- simulate.999(mean = R1.means[i], sd = R1.sds[i], n = sample.size)
R2.se[i] <- sd(R2$percentiles)
}
R1.percentiles <- R1$percentiles
CI.min <- numeric(999)
CI.max <- numeric(999)
for (i in 1:999){
CI.min[i] <- R1.percentiles[i]-1.96*R2.se[i]
CI.max[i] <- R1.percentiles[i]+1.96*R2.se[i]
}
count <- 0
for (i in 1:999){
if(true.99.9 <= CI.max[i] && true.99.9 >= CI.min[i]){
count <- count + 1
}
}
print(paste0("Count of confidence intervals that contain the true percentile: ", count))
print(paste0("This is equal to a correct percentage of: ", 100*count/999,"%"))
get.MLE.B <- function(obs){
return (sum(obs)/(2*length(obs)))
}
get.MLE.B(c(9,5,7))
est <- get.MLE.B(c(9,5,7))
est
scales <- numeric(1000)
scale <- est
for(i in 1:1000){
sim <- rgamma(3, shape = 2, scale = scale)
scales[i] <- get.MLE.B(sim)
}
print(paste0("Bootstrap estimate of standard error for B: ", sd(scales)))
scales <- numeric(1000)
scale <- est
for(i in 1:1000){
sim <- rgamma(3, shape = 2, scale = scale)
scales[i] <- get.MLE.B(sim)
}
print(paste0("Bootstrap estimate of standard error for B: ", sd(scales)))
scales
