locationAddress = NULL,
offset = 0,
limit = maxLimit){
request_url = paste0(base_url,"locations/?offset=",offset,"&limit=",limit,"&distanceUnit=",distanceUnit)
if(!is.null(includeDeleted)){
request_url <- paste0(request_url,"&includeDeleted=",includeDeleted)
}
#if(!is.null(sort)){
#request_url <- paste0(request_url,"&sort=",sort)
#}
if(!is.null(namePrefix)){
request_url <- paste0(request_url,"&namePrefix=",namePrefix)
}
if(!is.null(maxPopulation)){
request_url <- paste0(request_url,"&maxPopulation=",maxPopulation)
}
if(!is.null(minPopulation)){
request_url <- paste0(request_url,"&minPopulation=",minPopulation)
}
if(!is.null(radius)){
request_url <- paste0(request_url,"&radius=",radius)
}
print(locationAddress)
if(!is.null(latitude) && !is.null(longitude)){
request_url <- paste0(request_url,"&location=", convertLongitudeLatitudeToISO(latitude, longitude))
}else if(!is.null(locationAddress)){
print("getting location")
locationAddress <- getLongitudeLatitude(locationAddress)
print(locationAddress)
request_url <- paste0(request_url,"&location=",locationAddress)
}
if(!includeCities && !includeDistricts){
return (list(count = 0, data = data.frame()))
}
else if(!includeDistricts && includeCities){
request_url <- paste0(request_url,"&types=", "CITY")
}
else if(includeDistricts && !includeCities){
request_url <- paste0(request_url,"&types=", "ADM2")
}
if(!is.null(includeDeleted)){
request_url <- paste0(request_url,"&includeDeleted=", includeDeleted)
}
#if(!is.null(excludedCountries)){
#request_url <- paste0(request_url,"&radius=",radius)
#}
print(request_url)
response <- makeRequest(request_url)
data <- response$data
if(!is.null(columns)){
data <- data[columns]
}
else if(!includeAllColumns){
data <- data[c("type", "name", "country", "countryCode", "region", "regionCode", "latitude", "longitude", "population", "distance")]
}
count <- response$metadata$totalCount
#return (list(data))
return (list(count = count, data = as.data.frame(data)))
}
GEO.FindCities <- function(includeDistricts = FALSE,
includeCities = TRUE,
includeAllColumns = FALSE,
columns = NULL,
includeDeleted = NULL,
namePrefix = NULL,
maxPopulation = NULL,
minPopulation = NULL,
excludedCountries = NULL,
countries = NULL,
distanceUnit = "KM",
radius = NULL,
longitude = NULL,
latitude = NULL,
locationAddress = NULL,
offset = 0,
limit = maxLimit){
request_url = paste0(base_url,"cities?offset=",offset,"&limit=",limit,"&distanceUnit=",distanceUnit)
if(!is.null(includeDeleted)){
request_url <- paste0(request_url,"&includeDeleted=",includeDeleted)
}
#if(!is.null(sort)){
#request_url <- paste0(request_url,"&sort=",sort)
#}
if(!is.null(namePrefix)){
request_url <- paste0(request_url,"&namePrefix=",namePrefix)
}
if(!is.null(maxPopulation)){
request_url <- paste0(request_url,"&maxPopulation=",maxPopulation)
}
if(!is.null(minPopulation)){
request_url <- paste0(request_url,"&minPopulation=",minPopulation)
}
if(!is.null(radius)){
request_url <- paste0(request_url,"&radius=",radius)
}
print(locationAddress)
if(!is.null(latitude) && !is.null(longitude)){
request_url <- paste0(request_url,"&location=", convertLongitudeLatitudeToISO(latitude, longitude))
}else if(!is.null(locationAddress)){
print("getting location")
locationAddress <- getLongitudeLatitude(locationAddress)
print(locationAddress)
request_url <- paste0(request_url,"&location=",locationAddress)
}
if(!includeCities && !includeDistricts){
return (list(count = 0, data = data.frame()))
}
else if(!includeDistricts && includeCities){
request_url <- paste0(request_url,"&types=", "CITY")
}
else if(includeDistricts && !includeCities){
request_url <- paste0(request_url,"&types=", "ADM2")
}
if(!is.null(includeDeleted)){
request_url <- paste0(request_url,"&includeDeleted=", includeDeleted)
}
#if(!is.null(excludedCountries)){
#request_url <- paste0(request_url,"&radius=",radius)
#}
print(request_url)
response <- makeRequest(request_url)
data <- response$data
if(!is.null(columns)){
data <- data[columns]
}
else if(!includeAllColumns){
data <- data[c("type", "name", "country", "countryCode", "region", "regionCode", "latitude", "longitude", "population", "distance")]
}
count <- response$metadata$totalCount
#return (list(data))
return (list(count = count, data = as.data.frame(data)))
}
